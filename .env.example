# PayPilot environment configuration (copy to .env and fill in)

# --- PayPal mode -------------------------------------------------------
# mock  = offline in-process mock (default, no credentials needed)
# live  = PayPal sandbox (https://api-m.sandbox.paypal.com)
PAYPILOT_PAYPAL_MODE=mock

# --- PayPal sandbox credentials (live mode) -----------------------------
# Create a free sandbox REST app at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- LLM brain (optional) ----------------------------------------------
# Any OpenAI-compatible chat endpoint. If unreachable, PayPilot falls back
# to its deterministic offline brain automatically.
PAYPILOT_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
PAYPILOT_LLM_API_KEY=
PAYPILOT_LLM_MODEL=mimo-v2-flash
